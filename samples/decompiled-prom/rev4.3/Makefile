# Auto-generated Makefile for building PROM image
# Generated by ip32prom-decompiler

# Tools (defaults for standalone use; parent Makefile exports overrides)
MIPS_CHOST_CANDIDATES := mips64-unknown-linux-gnu- mips64-linux-gnu- mips-linux-gnu-
detect_mips_chost = $(firstword $(foreach prefix,$(MIPS_CHOST_CANDIDATES),$(if $(shell command -v $(prefix)as 2>/dev/null),$(prefix))))
MIPS_CHOST ?= $(or $(detect_mips_chost),mips-linux-gnu-)
CHECKSUM ?= cargo run --manifest-path ../Cargo.toml --release --bin ip32prom-checksum --

# Flags
MIPS_FLAGS = -mabi=64 -march=mips3
LDFLAGS = -EB -melf64btsmip -static

# SHDR alignment
ROM_ALIGN = 256

# Output
PROM = prom.bin

# Sections
CHECKSUM_SECTIONS = sloader env post1
ALL_SECTIONS = $(CHECKSUM_SECTIONS) trailing

# Derived file lists
BIN_FILES = $(addsuffix .bin,$(ALL_SECTIONS))
CHECKSUM_BIN_FILES = $(addsuffix .bin,$(CHECKSUM_SECTIONS))

# Disable built-in suffix rules
.SUFFIXES:

# Delete partial files on error
.DELETE_ON_ERROR:

# Default target
all: $(PROM)

# Helper to pad a file to ROM_ALIGN boundary
define pad_to_align
	@size=$$(stat -c%s $(1)); \
	aligned_size=$$(( (size + $(ROM_ALIGN) - 1) / $(ROM_ALIGN) * $(ROM_ALIGN) )); \
	cp $(1) $(2); \
	truncate -s $$aligned_size $(2)
endef

# Concatenate all section binaries into final PROM image
$(PROM): $(BIN_FILES)
	cat $^ > $@

# Preprocess .S files to .s files
%.s: %.S definitions.h macros.inc
	$(CPP) $< -o $@

# Assemble .s files to .o files
%.o: %.s
	$(MIPS_CHOST)as $(MIPS_FLAGS) $< -o $@

# sloader section (code)
sloader.elf: sloader.o sloader.lds
	$(MIPS_CHOST)ld $(MIPS_FLAGS) $(LDFLAGS) -T sloader.lds $< -o $@

sloader.bin: sloader.elf
	$(MIPS_CHOST)objcopy -j .text -O binary $< $@.tmp
	$(call pad_to_align,$@.tmp,$@)
	@rm -f $@.tmp
	$(CHECKSUM) --set $@

# post1 section (code)
post1.elf: post1.o post1.lds
	$(MIPS_CHOST)ld $(MIPS_FLAGS) $(LDFLAGS) -T post1.lds $< -o $@

post1.bin: post1.elf
	$(MIPS_CHOST)objcopy -j .text -O binary $< $@.tmp
	$(call pad_to_align,$@.tmp,$@)
	@rm -f $@.tmp
	$(CHECKSUM) --set $@

# env section (data)
env.bin: env.o
	$(MIPS_CHOST)objcopy -j .text -O binary $< $@.tmp
	$(call pad_to_align,$@.tmp,$@)
	@rm -f $@.tmp
	$(CHECKSUM) --set $@

# Trailing data (no SHDR, no checksum)
trailing.bin: trailing.o
	$(MIPS_CHOST)objcopy -j .text -O binary $< $@

# Verify checksums in all section binaries
verify-checksums: $(CHECKSUM_BIN_FILES)
	@echo "Verifying section checksums..."
	@for f in $(CHECKSUM_BIN_FILES); do \
		$(CHECKSUM) --verify "$$f" || exit 1; \
		echo ""; \
	done
	@echo "All section checksums verified!"

# Clean generated files
clean:
	rm -f *.o *.s *.elf *.bin *.tmp

.PHONY: all clean verify-checksums
